# Copy this to .env.local and fill in the values. .env.local is gitignored;
# never commit real keys, and never paste them onto a command line, where
# they end up in shell history.
#
# Everything here is optional. With none of it set the product runs exactly
# as it does now: billing endpoints refuse, and emails are written to the
# API log instead of being sent.

# --- Stripe ------------------------------------------------------------
# Dashboard → Developers → API keys. Use the *test* key (sk_test_…) until
# you are ready to charge real cards.
STRIPE_SECRET_KEY=

# Dashboard → Developers → Webhooks → your endpoint → signing secret.
# Locally, `stripe listen` prints one when it starts.
STRIPE_WEBHOOK_SECRET=

# Dashboard → Product catalogue. Create one product with two prices, then
# paste the price ids (price_…, not the product id).
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_YEARLY=

# --- Email -------------------------------------------------------------
# resend.com → API keys. Without this, messages are logged instead of sent
# and confirmation links appear in the API output.
RESEND_API_KEY=
# Quoted: this file is read with `source`, so an unquoted < or > is a shell
# redirection rather than part of a value.
MAIL_FROM="Glarion <noreply@glarion.app>"

# Where links in emails should point. Must be the real domain in
# production: a link built from a request header is how confirmation mail
# becomes phishing.
PUBLIC_URL=http://localhost:5173
