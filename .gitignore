/target

# Secrets and local configuration. Nothing matching these should ever be
# committed; the dev database keeps its generated password outside the repo
# entirely (~/.glarion-devdb), which is why no path here refers to it.
.env
.env.*
*.env
*.env.local
# The documented template carries no values and has to be readable by
# anyone setting the project up.
!.env.local.example
secrets.*
*.pem
*.key
*.p12
*.pfx
credentials.json

# Scan output and reports may contain findings about real customer sites.
/scan-output
/reports
*.report.json

# Editor and OS noise
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
.preview/
.runtime/
/.impeccable/review/

# Frontend build output and dependencies
web/node_modules/
web/dist/

# Local editor/tool settings
.claude/

# Internal planning, design and review notes (kept out of the public repository)
/.impeccable/
/PIANO-CRESCITA.md
/VERIFICA-*.md
/PRODUCT.md
/DESIGN.md
/docs/growth/
/docs/DEPLOYMENT.md
/docs/LOCAL-RECOVERY.md
/docs/releases/
